{
  "rewrites": [
    {
      "source": "/e/:id",
      "destination": "/api/e?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/c/:cat",
      "destination": "/api/cat?c=:cat"
    },
    {
      "source": "/week",
      "destination": "/api/cat?c=week"
    }
  ],
  "crons": [
    {
      "path": "/api/daily",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/today",
      "schedule": "0 10 * * *"
    }
  ]
}